{
  "framework": null,

  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand":   "pnpm --filter @workspace/jarvis-dashboard run build",
  "outputDirectory": "artifacts/jarvis-dashboard/dist/public",

  "env": {
    "BASE_PATH":    "/",
    "NODE_ENV":     "production"
  },

  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],

  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
